+// Reserve the selected embedded firmware payload early, before a recording requests
+// DSP startup. DSP power management and firmware contents stay unchanged.
+bool TGLDmic::reserveBootBuffers() {
+    bool useCml = platformFamily == kPlatformCometLake;
+    char fwArg[16] = {};
+    if (PE_parse_boot_argn("tgldmicfw", fwArg, sizeof(fwArg))) {
+        if (strcmp(fwArg, "cml") == 0 || strcmp(fwArg, "cnl") == 0) useCml = true;
+        else if (strcmp(fwArg, "tgl") == 0) useCml = false;
+    }
+    const unsigned char *data = useCml ? kSofCmlRi : kSofTglRi;
+    size_t total = useCml ? kSofCmlRiSize : kSofTglRiSize;
+    const uint32_t *words = reinterpret_cast<const uint32_t *>(data);
+    size_t skip = words[0] == XMAN_MAGIC ? words[1] : 0;
+    if (skip >= total) return false;
+    if (!clBuf.alloc(pci, total - skip)) {
+        LOG("DMA reserve: firmware buffer failed 0x%x", clBuf.lastError); return false;
+    }
+    if (!bdlBuf.alloc(pci, 4096)) {
+        LOG("DMA reserve: BDL buffer failed 0x%x", bdlBuf.lastError); return false;
+    }
+    LOG("DMA reserve: firmware %zu bytes + BDL %zu bytes ready", clBuf.size, bdlBuf.size);
+    return true;
+}
